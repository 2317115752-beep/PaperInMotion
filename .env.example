# Alibaba Cloud Bailian: Beijing API Key (already bound to its business workspace).
# Get a key at https://bailian.console.aliyun.com/cn-beijing/?tab=api#/api
DASHSCOPE_API_KEY=
# Use the official shared Beijing endpoint. No workspace ID is needed in this mode.
BAILIAN_ENDPOINT_MODE=shared
# Optional: only used when BAILIAN_ENDPOINT_MODE=workspace.
BAILIAN_WORKSPACE_ID=
BAILIAN_CHAT_MODEL=qwen3.8-flash
BAILIAN_TTS_MODEL=qwen-audio-3.1-tts-flash
# Application output budget per planning call, valid range 1024-32768.
BAILIAN_CHAT_MAX_TOKENS=12000
# This voice supports both Mandarin and English; generate one language per video.
BAILIAN_TTS_VOICE_ZH=loongbella_v3.1
BAILIAN_TTS_VOICE_EN=loongbella_v3.1
